# =====================================================
# Configuración de Entorno - Sistema POS Librería
# Copiar este archivo a ".env" y completar valores reales
# =====================================================

# Perfil de Spring Boot: dev | prod
SPRING_PROFILES_ACTIVE=prod

# Base de Datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/bd_libreria
DB_USER=user_libreria
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

# Clave JWT en formato Base64 válido (>= 256 bits / 32 bytes)
# Generar en PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=REEMPLAZAR_CON_CLAVE_BASE64_DE_32_BYTES
JWT_EXPIRATION=86400000

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
